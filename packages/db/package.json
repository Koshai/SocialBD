{
  "name": "@socialbd/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:setup": "node ./scripts/setup-db.mjs",
    "db:migrate:orgs": "node ./scripts/migrate-orgs.mjs",
    "db:migrate:channels": "node ./scripts/migrate-connected-accounts.mjs",
    "db:migrate:posts": "node ./scripts/migrate-posts.mjs",
    "db:verify": "node ./scripts/verify-auth.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.40.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@socialbd/eslint-config": "workspace:*",
    "@socialbd/typescript-config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9",
    "typescript": "^5.8.3"
  }
}
