{
  "name": "socialbd",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:migrate": "pnpm --filter @socialbd/db db:migrate",
    "db:push": "pnpm --filter @socialbd/db db:push",
    "db:setup": "pnpm --filter @socialbd/db db:setup",
    "db:verify": "pnpm --filter @socialbd/db db:verify",
    "db:migrate:orgs": "pnpm --filter @socialbd/db db:migrate:orgs",
    "db:migrate:channels": "pnpm --filter @socialbd/db db:migrate:channels",
    "db:migrate:posts": "pnpm --filter @socialbd/db db:migrate:posts",
    "db:migrate:media": "pnpm --filter @socialbd/db db:migrate:media",
    "db:migrate:ideas": "pnpm --filter @socialbd/db db:migrate:ideas",
    "db:migrate:idea-gallery": "pnpm --filter @socialbd/db db:migrate:idea-gallery",
    "db:migrate:workspace-gallery": "pnpm --filter @socialbd/db db:migrate:workspace-gallery",
    "db:migrate:all": "pnpm --filter @socialbd/db db:migrate:all",
    "db:promote-owners": "pnpm --filter @socialbd/db db:promote-owners",
    "start:web": "pnpm --filter @socialbd/web start",
    "start:worker": "pnpm --filter @socialbd/worker start",
    "build:web": "pnpm --filter @socialbd/web build",
    "build:worker": "pnpm --filter @socialbd/worker build"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.9.0 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
